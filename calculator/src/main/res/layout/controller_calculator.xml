<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/calculator_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/horiz_line_upper"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="@fraction/percent_guideline_calculator_upper" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/horiz_line_lower"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="@fraction/percent_guideline_calculator_lower" />

    <View
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?android:attr/listDivider"
        app:layout_constraintTop_toBottomOf="@id/horiz_line_lower" />

    <androidx.viewpager.widget.ViewPager
        android:id="@+id/keyboard_view_pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/divider"
        app:layout_constraintVertical_bias="1.0" />

    <Button
        android:id="@+id/history_button"
        style="@style/Widget.ArchitexCalc.Button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/history_button_label"
        app:layout_constraintBottom_toTopOf="@+id/keyboard_view_pager"
        app:layout_constraintEnd_toStartOf="@+id/pager_indicator"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/horiz_line_upper" />

    <com.tbuonomo.viewpagerdotsindicator.WormDotsIndicator
        android:id="@+id/pager_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:dotsColor="?attr/colorPrimaryVariant"
        app:dotsCornerRadius="8dp"
        app:dotsSize="8dp"
        app:dotsSpacing="4dp"
        app:dotsStrokeColor="?attr/colorPrimary"
        app:dotsStrokeWidth="2dp"
        app:layout_constraintBottom_toTopOf="@+id/keyboard_view_pager"
        app:layout_constraintEnd_toStartOf="@+id/settings_button"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintStart_toEndOf="@+id/history_button"
        app:layout_constraintTop_toTopOf="@+id/horiz_line_upper" />

    <Button
        android:id="@+id/settings_button"
        style="@style/Widget.ArchitexCalc.Button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/settings_button_label"
        app:layout_constraintBottom_toTopOf="@+id/keyboard_view_pager"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintStart_toEndOf="@+id/pager_indicator"
        app:layout_constraintTop_toTopOf="@+id/horiz_line_upper" />

    <com.manueldidonna.architexcalc.core.ui.HorizontalScrollTextView
        android:id="@+id/scrollable_expression"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toTopOf="@+id/scrollable_result"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:textAppearance="@style/TextAppearance.MaterialComponents.Headline4"
        app:textColor="?attr/textColorMediumEmphasis"
        app:textGravity="end"
        app:textSize="48sp"
        tools:text="156+156" />

    <com.manueldidonna.architexcalc.core.ui.HorizontalScrollTextView
        android:id="@+id/scrollable_result"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="24dp"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintBottom_toTopOf="@+id/horiz_line_upper"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:textAppearance="@style/TextAppearance.MaterialComponents.Headline3"
        app:textColor="?attr/textColorHighEmphasis"
        app:textGravity="end"
        app:textSize="60sp"
        tools:text="312" />

</androidx.constraintlayout.widget.ConstraintLayout>