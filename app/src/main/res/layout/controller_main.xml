<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/calculator_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/horiz_line_upper"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="@fraction/percent_guideline_calculator_upper" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/horiz_line_lower"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="@fraction/percent_guideline_calculator_lower" />

    <androidx.viewpager.widget.ViewPager
        android:id="@+id/keyboard_view_pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="@+id/horiz_line_lower"
        app:layout_constraintVertical_bias="1.0"
        tools:layout_editor_absoluteX="248dp" />

    <Button
        android:id="@+id/history_button"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/calculator_history"
        android:textColor="?attr/colorSecondary"
        app:layout_constraintBottom_toTopOf="@+id/keyboard_view_pager"
        app:layout_constraintEnd_toStartOf="@+id/pager_indicator"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/horiz_line_upper"
        app:rippleColor="?attr/colorSecondaryVariant" />

    <com.tbuonomo.viewpagerdotsindicator.WormDotsIndicator
        android:id="@+id/pager_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:dotsColor="?attr/colorSecondaryVariant"
        app:dotsCornerRadius="8dp"
        app:dotsSize="8dp"
        app:dotsSpacing="4dp"
        app:dotsStrokeColor="?attr/colorSecondary"
        app:dotsStrokeWidth="2dp"
        app:layout_constraintBottom_toTopOf="@+id/keyboard_view_pager"
        app:layout_constraintEnd_toStartOf="@+id/settings_button"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintStart_toEndOf="@+id/history_button"
        app:layout_constraintTop_toTopOf="@+id/horiz_line_upper" />

    <Button
        android:id="@+id/settings_button"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/calculator_settings"
        android:textColor="?attr/colorSecondary"
        app:layout_constraintBottom_toTopOf="@+id/keyboard_view_pager"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintStart_toEndOf="@+id/pager_indicator"
        app:layout_constraintTop_toTopOf="@+id/horiz_line_upper"
        app:rippleColor="?attr/colorSecondaryVariant" />

    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/expression_text_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:backgroundTint="#00000000"
        android:gravity="end|center_vertical"
        android:inputType="none"
        android:textIsSelectable="false"
        android:paddingStart="24dp"
        android:paddingTop="16dp"
        android:paddingEnd="24dp"
        android:paddingBottom="8dp"
        android:singleLine="true"
        android:textAppearance="@style/TextAppearance.MaterialComponents.Headline5"
        android:textColor="?attr/colorSecondaryVariant"
        android:textSize="42sp"
        app:layout_constraintBottom_toTopOf="@+id/result_text_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:text="159 + 159" />

    <TextView
        android:id="@+id/result_text_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:gravity="end|center_vertical"
        android:paddingStart="24dp"
        android:paddingTop="8dp"
        android:paddingEnd="24dp"
        android:paddingBottom="8dp"
        android:singleLine="true"
        android:textAppearance="@style/TextAppearance.MaterialComponents.Headline3"
        android:textColor="@android:color/white"
        android:textSize="60sp"
        app:layout_constraintBottom_toTopOf="@+id/horiz_line_upper"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:text="318" />

</androidx.constraintlayout.widget.ConstraintLayout>