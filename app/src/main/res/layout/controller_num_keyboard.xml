<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/vert_line_25"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.25" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/horiz_line_25"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.25" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/horiz_line_50"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.5" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/horiz_line_75"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.75" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/vert_line_50"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.5" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/vert_line_75"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.75" />

    <TextView
        android:id="@+id/seven_button"
        style="@style/Keyboard.Button.Common"
        tools:ignore="HardcodedText"
        android:text="7"
        app:layout_constraintBottom_toTopOf="@+id/horiz_line_25"
        app:layout_constraintEnd_toStartOf="@+id/vert_line_25"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1.0" />

    <TextView
        android:id="@+id/eight_button"
        style="@style/Keyboard.Button.Common"
        tools:ignore="HardcodedText"
        android:text="8"
        app:layout_constraintBottom_toTopOf="@+id/horiz_line_25"
        app:layout_constraintEnd_toStartOf="@id/vert_line_50"
        app:layout_constraintStart_toStartOf="@+id/vert_line_25"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/nine_button"
        style="@style/Keyboard.Button.Common"
        tools:ignore="HardcodedText"
        android:text="9"
        app:layout_constraintBottom_toTopOf="@+id/horiz_line_25"
        app:layout_constraintEnd_toEndOf="@id/vert_line_75"
        app:layout_constraintStart_toStartOf="@+id/vert_line_50"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/four_button"
        style="@style/Keyboard.Button.Common"
        tools:ignore="HardcodedText"
        android:text="4"
        app:layout_constraintBottom_toTopOf="@+id/horiz_line_50"
        app:layout_constraintEnd_toEndOf="@id/vert_line_25"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/horiz_line_25" />

    <TextView
        android:id="@+id/five_button"
        style="@style/Keyboard.Button.Common"
        tools:ignore="HardcodedText"
        android:text="5"
        app:layout_constraintBottom_toTopOf="@+id/horiz_line_50"
        app:layout_constraintEnd_toEndOf="@id/vert_line_50"
        app:layout_constraintStart_toStartOf="@id/vert_line_25"
        app:layout_constraintTop_toTopOf="@id/horiz_line_25" />

    <TextView
        android:id="@+id/six_button"
        style="@style/Keyboard.Button.Common"
        tools:ignore="HardcodedText"
        android:text="6"
        app:layout_constraintBottom_toTopOf="@+id/horiz_line_50"
        app:layout_constraintEnd_toEndOf="@id/vert_line_75"
        app:layout_constraintStart_toStartOf="@id/vert_line_50"
        app:layout_constraintTop_toTopOf="@id/horiz_line_25" />

    <TextView
        android:id="@+id/one_button"
        style="@style/Keyboard.Button.Common"
        tools:ignore="HardcodedText"
        android:text="1"
        app:layout_constraintBottom_toTopOf="@+id/horiz_line_75"
        app:layout_constraintEnd_toEndOf="@id/vert_line_25"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/horiz_line_50" />

    <TextView
        android:id="@+id/two_button"
        style="@style/Keyboard.Button.Common"
        tools:ignore="HardcodedText"
        android:text="2"
        app:layout_constraintBottom_toTopOf="@+id/horiz_line_75"
        app:layout_constraintEnd_toEndOf="@id/vert_line_50"
        app:layout_constraintStart_toStartOf="@id/vert_line_25"
        app:layout_constraintTop_toTopOf="@id/horiz_line_50" />

    <TextView
        android:id="@+id/three_button"
        style="@style/Keyboard.Button.Common"
        tools:ignore="HardcodedText"
        android:text="3"
        app:layout_constraintBottom_toTopOf="@+id/horiz_line_75"
        app:layout_constraintEnd_toEndOf="@id/vert_line_75"
        app:layout_constraintStart_toStartOf="@id/vert_line_50"
        app:layout_constraintTop_toTopOf="@id/horiz_line_50" />

    <TextView
        android:id="@+id/zero_button"
        style="@style/Keyboard.Button.Common"
        tools:ignore="HardcodedText"
        android:text="0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/vert_line_50"
        app:layout_constraintStart_toStartOf="@id/vert_line_25"
        app:layout_constraintTop_toTopOf="@id/horiz_line_75" />

    <TextView
        android:id="@+id/cancel_button"
        style="@style/Keyboard.Button.Common"
        tools:ignore="HardcodedText"
        android:text="C"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/vert_line_75"
        app:layout_constraintStart_toStartOf="@id/vert_line_50"
        app:layout_constraintTop_toTopOf="@id/horiz_line_75" />

    <TextView
        android:id="@+id/dot_button"
        style="@style/Keyboard.Button.Common"
        tools:ignore="HardcodedText"
        android:text=","
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/vert_line_25"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/horiz_line_75" />

    <TextView
        android:id="@+id/equal_button"
        style="@style/Keyboard.Button.Extra"
        tools:ignore="HardcodedText"
        android:text="="
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/vert_line_75"
        app:layout_constraintTop_toTopOf="@id/horiz_line_75" />

    <TextView
        android:id="@+id/plus_minus_button"
        style="@style/Keyboard.Button.Extra"
        tools:ignore="HardcodedText"
        android:text="±"
        app:layout_constraintBottom_toBottomOf="@id/horiz_line_75"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/vert_line_75"
        app:layout_constraintTop_toTopOf="@id/horiz_line_50" />

    <TextView
        android:id="@+id/multiply_button"
        style="@style/Keyboard.Button.Extra"
        tools:ignore="HardcodedText"
        android:text="×"
        app:layout_constraintBottom_toBottomOf="@id/horiz_line_50"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/vert_line_75"
        app:layout_constraintTop_toTopOf="@id/horiz_line_25" />

    <TextView
        android:id="@+id/div_button"
        style="@style/Keyboard.Button.Extra"
        tools:ignore="HardcodedText"
        android:text="÷"
        app:layout_constraintBottom_toBottomOf="@id/horiz_line_25"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/vert_line_75"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>