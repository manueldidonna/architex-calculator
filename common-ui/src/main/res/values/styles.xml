<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Widget.ArchitexCalc.Button" parent="Widget.MaterialComponents.Button.TextButton" />

    <style name="Widget.ArchitexCalc.Button.Secondary" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">?attr/colorSecondary</item>
        <item name="rippleColor">@color/text_button_ripple_color</item>
    </style>

    <style name="Widget.ArchitexCalc.Toolbar.Icon" parent="">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:padding">8dp</item>
        <item name="android:tint">?attr/colorPrimary</item>
    </style>

    <style name="TextAppearance.ArchitexCalc.Dialog.Title" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textColor">?attr/textColorHighEmphasis</item>
    </style>

    <style name="TextAppearance.ArchitexCalc.Toolbar.Title" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>

</resources>