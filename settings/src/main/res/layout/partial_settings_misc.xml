<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:layout_width="match_parent"
    tools:layout_height="wrap_content"
    tools:orientation="vertical"
    tools:parentTag="android.widget.LinearLayout">

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/settings_double_tap_exit"
        style="@style/Widget.AppCompat.CompoundButton.Switch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:padding="16dp"
        tools:checked="true"
        android:text="@string/settings_double_tap_exit"
        android:textAppearance="@style/TextAppearance.MaterialComponents.Subtitle1" />

    <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/settings_tap_back_delete"
            style="@style/Widget.AppCompat.CompoundButton.Switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:padding="16dp"
            tools:checked="false"
            android:text="@string/settings_tap_back_delete"
            android:textAppearance="@style/TextAppearance.MaterialComponents.Subtitle1" />

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/settings_ask_clearing_history"
        style="@style/Widget.AppCompat.CompoundButton.Switch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:padding="16dp"
        android:text="@string/settings_ask_before_deleting_history"
        android:textAppearance="@style/TextAppearance.MaterialComponents.Subtitle1" />

    <LinearLayout
        android:id="@+id/settings_auto_clear_history"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical">

        <androidx.appcompat.widget.AppCompatTextView
            style="@style/TextAppearance.MaterialComponents.Subtitle1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp"
            android:text="@string/settings_auto_clear_history" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/settings_auto_clear_value"
            style="@style/TextAppearance.MaterialComponents.Subtitle2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp"
            android:textColor="?attr/colorSecondaryVariant"
            tools:text="Never" />
    </LinearLayout>
</merge>