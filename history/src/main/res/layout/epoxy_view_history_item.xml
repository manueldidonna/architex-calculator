<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:layout_height="wrap_content"
    tools:layout_width="match_parent"
    tools:parentTag="androidx.constraintlayout.widget.ConstraintLayout">

    <com.manueldidonna.architexcalc.common.ui.widgets.HorizontalScrollTextView
        android:id="@+id/expression"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/selection_check_box"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginStart="16dp"
        app:textAppearance="@style/TextAppearance.MaterialComponents.Headline4"
        app:textColor="?attr/textColorMediumEmphasis"
        app:textGravity="start"
        tools:text="Expression" />

    <com.manueldidonna.architexcalc.common.ui.widgets.HorizontalScrollTextView
        android:id="@+id/result"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/selection_check_box"
        app:layout_constraintTop_toBottomOf="@+id/expression"
        app:layout_goneMarginStart="16dp"
        app:textAppearance="@style/TextAppearance.MaterialComponents.Headline4"
        app:textColor="?attr/textColorHighEmphasis"
        app:textGravity="start"
        tools:text="Result" />

    <androidx.appcompat.widget.AppCompatCheckBox
        android:id="@+id/selection_check_box"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:checked="false"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:checked="true"
        tools:visibility="visible" />
</merge>