<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Keyboard Buttons -->
    <style name="Keyboard.Button" parent="Widget.AppCompat.TextView">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>

        <item name="fontFamily">sans-serif</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:gravity">center|center_horizontal|center_vertical</item>
        <item name="autoSizeTextType">uniform</item>
    </style>

    <style name="Keyboard.Button.Common">
        <item name="android:textColor">?attr/colorOnBackground</item>
        <item name="autoSizeMaxTextSize">28sp</item>
        <item name="autoSizeMinTextSize">12sp</item>
        <item name="autoSizeStepGranularity">4sp</item>
    </style>

    <style name="Keyboard.Button.Extra">
        <item name="android:textColor">?attr/colorSecondary</item>
        <item name="autoSizeMaxTextSize">34sp</item>
        <item name="autoSizeMinTextSize">22sp</item>
        <item name="autoSizeStepGranularity">4sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Toolbar -->

    <style name="Toolbar.Title.Appearance" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textColor">?attr/colorSecondary</item>
    </style>

</resources>